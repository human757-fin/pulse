{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pulse",
  "version": "0.3.4-1",
  "identifier": "com.pulse.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pulse",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3NjhFQTA4RTkyRjg5REYKUldUZmlTL3BDT3BvTjdUTEtWVE9uQnlnV0liN0hCckhwSWorZVZJbzA2Nm5XV1BOZ2ZQcXRocnUK",
      "endpoints": [
        "https://pulse.overclockd.shop/api/updater/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
