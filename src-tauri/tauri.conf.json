{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Umbra Chat",
  "mainBinaryName": "UmbraChat",
  "version": "0.3.18-5",
  "identifier": "com.pulse.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Umbra",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling"
      }
    ]
  },
  "bundle": {
    "active": true,
    "publisher": "Umbra",
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "installer/uninstall.ico",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "headerImage": "installer/nsis-header.bmp",
        "uninstallerHeaderImage": "installer/nsis-uninstall-header.bmp"
      },
      "wix": {
        "upgradeCode": "f489e72e-67e7-532a-9abe-1104ee33e0b3",
        "bannerPath": "installer/msi-banner.bmp",
        "dialogImagePath": "installer/msi-dialog.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM3NjhFQTA4RTkyRjg5REYKUldUZmlTL3BDT3BvTjdUTEtWVE9uQnlnV0liN0hCckhwSWorZVZJbzA2Nm5XV1BOZ2ZQcXRocnUK",
      "endpoints": [
        "https://pulse.overclockd.shop/api/updater/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
